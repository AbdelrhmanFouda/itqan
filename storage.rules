rules_version = '2';

// Firebase STORAGE rules — photos of the paper hourly log sheet.
//
// ⚠ Publishing these is a manual step, exactly like firestore.rules: pushing to
// git does not deploy them. Firebase console → Storage → Rules → Publish, or
// `firebase deploy --only storage`. Firebase Storage must also be ENABLED on the
// project before the bucket exists at all.
//
// Unlike the Firestore collections in this app, these rules are REAL enforcement.
// The images are uploaded straight from the browser by the signed-in user
// (lib/photo-upload.ts), so `request.auth` is genuinely populated here — the
// server never handles the bytes.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    // hourly/<YYYY-MM-DD>/<machine-slug>/<timestamp>.jpg
    match /hourly/{date}/{machine}/{file} {
      // Any signed-in user may read: the hourly page shows the day's sheets to
      // production, quality, worker and the owner alike.
      allow read: if isSignedIn();

      // Write is deliberately narrow: signed in, a JPEG, and no larger than the
      // 4 MB ceiling the client compresses well below (a 1600px sheet is
      // 200–500 KB). Size and type are checked HERE because this is the only
      // place that sees the bytes.
      allow create: if isSignedIn()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/jpe?g');

      // Overwriting an existing object is not a thing this app does — a new
      // photo always gets a new timestamped path — so only delete is allowed.
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // Nothing else in the bucket is reachable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
