# Copy to .env.local and fill in. Every value here is BLANK on purpose — this
# file is the template, never a place to keep a real key. Restart `npm run dev`
# after changing anything.

# ---------------------------------------------------------------------------
# Firebase Web SDK — auth and roles ONLY (no factory data).
# Firebase console → Project settings → General → Your apps → Web app.
# NEXT_PUBLIC_ (exposed to the browser) is normal here: access is controlled by
# the Firestore security rules, not by hiding these values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# The workbook. Server-side only.
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_ID=

# Transport 1 — the Google Sheets REST API (primary since 2026-09-10). Reads and
# writes as the owner. Get the three values by opening /api/google/connect once
# and granting consent. With all three set, /api/health says transport: "api".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Transport 2 — the Apps Script bridge (fallback, and the ONLY path to Drive,
# which is where the voice notes live). Deploy apps-script.gs as a Web app
# (steps in its header) and paste its /exec URL here. The secret must match
# TOKEN in apps-script.gs — change one and you must change the other, then
# Deploy → Manage deployments → New version.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# The storage workbook («مخزن اتقان») has its own bridge and its own token.
STORAGE_APPS_SCRIPT_URL=
STORAGE_APPS_SCRIPT_SECRET=

# Region-shared copy of every sheet read (Vercel Runtime Cache). OFF unless
# this is exactly "on" — it took production down on 2026-09-09.
SHEET_SHARED_COPY=off

# ---------------------------------------------------------------------------
# AI (optional). Without a key the review falls back to the built-in draft.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_REVIEW_PROVIDER=
AI_REVIEW_MODEL=
AI_AGENT_MODEL=
AI_AGENT_DAILY_LIMIT=

# ---------------------------------------------------------------------------
# Website enquiries (optional). Without these a lead is still stored and shown
# on /dashboard/sales — nobody is emailed.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=
INQUIRY_NOTIFY_FROM=

# ---------------------------------------------------------------------------
# Public contact details (inlined at BUILD time — redeploy after changing).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
