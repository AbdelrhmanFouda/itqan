rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function ownerEmail() { return 'abdelrhman.2003.16@gmail.com'; }
    function isOwner() { return isSignedIn() && request.auth.token.email == ownerEmail(); }
    // Admins = the owner email OR any signed-in user whose granted role is
    // "manager" AND whose account is APPROVED.
    //
    // ⚠ The status check is not decoration. Without it a manager whose account
    // had been rejected or revoked kept full admin rights over every profile in
    // this collection — including the right to write `status: 'approved'` back
    // onto his own document. Revoking a manager did nothing until this line.
    function isManager() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function isAdmin() { return isOwner() || isManager(); }

    // -- User profiles: who is allowed in, their requested vs granted role, and
    //    approval status. This collection is genuinely protected.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // A user may create only their OWN profile. The owner email may bootstrap
      // itself as owner/approved; everyone else must start pending with no role.
      allow create: if isSignedIn() && request.auth.uid == uid && (
        request.auth.token.email == ownerEmail() ||
        (request.resource.data.status == 'pending' && request.resource.data.role == null)
      );

      // A user may edit their own profile but NOT change role/status.
      // Admins (owner + managers) may change anything — this is how approvals happen.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );

      allow delete: if isAdmin();
    }

    // -- Customer accounts (the buyer portal). A customer is an ACCOUNT KIND,
    //    never one of the staff roles: their document lives here, not in
    //    /users, so they never receive a role and every requireRole() handler
    //    refuses them by a property of the system rather than a remembered
    //    check.
    //
    //    The LINK to a client name («العملاء») lives in `clients` on this
    //    document and is the access boundary for everything the portal serves.
    //    It therefore cannot be written by the account itself — not at sign-up
    //    (the create rule forbids the field outright) and not afterwards (only
    //    an admin may update). The portal's own register route creates the
    //    document as the caller, pending and unlinked.
    match /customers/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && !('clients' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // -- Operational + public collections.
    // These are read/written through the app's /api routes using the
    // (unauthenticated) Firebase client SDK, so they stay open in this phase.
    // NOTE: there is deliberately NO `match /{document=**}` catch-all here —
    // an open catch-all would also open /users and defeat the rules above.
    // TODO (hardening): move /api to the Admin SDK with verified ID tokens,
    // then require auth + role here instead of `if true`.
    match /machines/{doc}         { allow read, write: if true; }
    match /machineNotes/{doc}     { allow read, write: if true; }
    match /monthlyReports/{doc}   { allow read, write: if true; }
    match /contactInquiries/{doc} { allow read, write: if true; }
    // PHASE 2 downtime capture — the ONE piece of factory data not in the sheet
    // (the owner ruled the workbook must not gain columns). Written by
    // /api/downtime, which verifies the caller's Firebase ID token via
    // requireRole; the server reaches Firestore through the unauthenticated
    // client SDK, so this must stay open exactly like the collections above.
    match /downtimeEvents/{doc}   { allow read, write: if true; }
    // «اسأل Claude» (2026-10-10) — questions, photos and the listener's
    // heartbeat. Written by /api/ask/* (staff: ID token + role; listener: its
    // own secret), through the same unauthenticated client SDK as the
    // collections above, so these must be open too. What is stored is
    // AES-256-GCM ciphertext under a key only the server holds
    // (lib/ask-crypto.ts): open rules leak nothing readable and a document
    // written by anyone else fails authentication and is ignored. They can
    // still be deleted from outside — the same exposure as downtimeEvents.
    match /askThreads/{doc}       { allow read, write: if true; }
    match /askPhotos/{doc}        { allow read, write: if true; }
    match /askMeta/{doc}          { allow read, write: if true; }
    // Daily AI-review cache (one doc per day per period) — written by /api/ai-review.
    match /aiReviews/{doc}        { allow read, write: if true; }

    // Per-user AI-assistant daily message counter (usage/{uid} = {date, count}).
    // A user may READ their own counter (to see remaining messages). Writes come
    // from /api/agent, which verifies the caller's Firebase ID token itself (no
    // Admin SDK — org policy blocks service-account keys), so the server can only
    // reach Firestore through the unauthenticated client SDK and needs write open
    // here. Abusing it only inflates the abuser's OWN limit, so the risk is low;
    // owner/manager are unlimited regardless. Harden once /api runs on the Admin SDK.
    match /usage/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if true;
    }
  }
}
